OPENROUTER_API_KEY=your-openrouter-api-key-here
OLLAMA_API_KEY=your-ollama-api-key-here
SECRET_KEY=change-me-in-production

# Logging configuration
# LOG_LEVEL options: DEBUG | INFO | WARNING | ERROR (default: INFO)
LOG_LEVEL=INFO
# LOG_FORMAT=%(asctime)s [%(levelname)s] %(name)s: %(message)s

# Set to "false" to keep the AI arena running even when no viewers are connected
ARENA_PAUSE_ON_EMPTY=true
# Comma-separated backend:model lineup for arena seats. Used as a backward-compatible
# single-lobby fallback when ARENA_LOBBIES is not set.
# ARENA_PLAYERS=ollama:deepseek-v4-pro,ollama:kimi-k2.6,ollama:glm-5.1,ollama:minimax-m2.7,ollama:gemma4:31b,ollama:nemotron-3-super,ollama:mistral-large-3:675b

# Multi-lobby arena configuration. Separate lobbies with semicolons.
# Format: Name|Description|backend:model,backend:model;Name|Description|backend:model
# ARENA_LOBBIES=Main Arena|Balanced mixed-model table|ollama:deepseek-v4-pro,openrouter:google/gemini-2.5-flash;Ollama Table|Ollama Cloud lineup|ollama:kimi-k2.6,ollama:qwen3.5:cloud

# PostgreSQL connection string (used by leaderboard and profiling services)
DATABASE_URL=postgresql://poker:poker@postgres:5432/poker

# AI Player Profiling configuration
# Set to "false" to disable all profiling (hand recording, stat aggregation, profile injection)
PROFILING_ENABLED=true
# Number of recent hands used for stat aggregation (default: 80)
STAT_WINDOW_SIZE=80
# Minimum hands before a player receives a classified profile instead of "Unknown" (default: 10)
MIN_HANDS_FOR_PROFILE=10
# Number of recent hand summaries included in the AI prompt (default: 5, set to 0 to disable)
INCLUDE_RECENT_HANDS=5
# Include the AI player's own profile in the prompt (default: true)
INCLUDE_SELF_STATS=true
